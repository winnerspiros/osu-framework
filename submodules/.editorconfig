# EditorConfig override for third-party fork code under submodules/.
# `root = true` stops .NET / EditorConfig inheritance of the osu-framework root .editorconfig for files
# under submodules/. Without this, the root .editorconfig's strict osu-framework style preferences
# would apply to third-party fork sources we don't own.
#
# Note: code-analysis rule severities for these projects are also controlled in
# submodules/Directory.Build.targets, which strips the osu-framework global analyzer config from
# submodule projects so that `-p:EnforceCodeStyleInBuild=true -warnaserror` (used by the Code Quality
# CI job) doesn't promote upstream-fork style decisions to errors.
root = true

[*.cs]
# Allow file-scoped namespaces (used by winnerspiros/veldrid-spirv) without IDE0160 errors.
csharp_style_namespace_declarations = file_scoped:silent

# Suppress redundant using directive (IDE0005 / InspectCode RemoveRedundantUsingDirective).
# Submodule files are third-party code we don't maintain, so style warnings are suppressed.
dotnet_diagnostic.IDE0005.severity = none
resharper_remove_redundant_using_directives_highlighting = none
