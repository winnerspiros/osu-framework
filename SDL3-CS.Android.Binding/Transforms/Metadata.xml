<metadata>
  <!--
    Remove all package-private SDL3 Java helper classes from the generated C# bindings.
    Only SDLActivity and SDLSurface are required by osu-framework.Android.

    Without these removals, the binding generator generates C# for the public classes
    (SDLActivity, SDLControllerManager) that reference these helper types, but the
    helpers themselves cannot be generated cleanly (they are package-private and/or
    reference Android APIs that cause generator failures). The result is CS0234 errors
    in the generated C# files.

    Removing them via remove-node causes the generator to also remove any methods/fields
    in other generated classes that reference these types.
  -->

  <!-- Controller / joystick / haptic helpers — cause SDLControllerManager.cs errors -->
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLControllerManager']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLHapticHandler']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLHapticHandler_API26']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLHapticHandler_API31']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLJoystickHandler']" />

  <!-- Clipboard helper — causes SDLActivity.cs error at line 84 -->
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLClipboardHandler']" />

  <!-- Generic motion listeners — cause SDLActivity.cs error at line 370 -->
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLGenericMotionListener_API14']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLGenericMotionListener_API24']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLGenericMotionListener_API26']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLGenericMotionListener_API29']" />

  <!-- Audio manager — not needed by osu-framework -->
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLAudioManager']" />

  <!-- Input connection — not needed -->
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLInputConnection']" />

  <!-- Edit text helper — not needed -->
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLDummyEdit']" />

  <!-- HID device classes — not needed -->
  <remove-node path="/api/package[@name='org.libsdl.app']/interface[@name='HIDDevice']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='HIDDeviceBLESteamController']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='HIDDeviceManager']" />
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='HIDDeviceUSB']" />

  <!-- SDL static helper class — not needed -->
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDL']" />

  <!-- SDLMain thread helper — not needed -->
  <remove-node path="/api/package[@name='org.libsdl.app']/class[@name='SDLMain']" />
</metadata>
