<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>osu!framework</AssemblyTitle>
    <AssemblyName>osu.Framework</AssemblyName>
    <Description>A 2D application/game framework written with rhythm games in mind.</Description>
    <!-- Enabling this breaks iOS projects from building due to silly naming conflicts (https://github.com/dotnet/runtime/issues/79500#issuecomment-1345624309).
         It's still enabled externally on packaging scripts so should be fine to disable in project. -->
    <!--<GenerateDocumentationFile>true</GenerateDocumentationFile>-->
    <NoWarn>$(NoWarn);CS1591;NU5104</NoWarn>
    <DefineConstants>$(DefineConstants);JETBRAINS_ANNOTATIONS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Label="Nuget">
    <Title>osu!framework</Title>
    <PackageId>ppy.osu.Framework</PackageId>
    <PackageReleaseNotes>Automated release.</PackageReleaseNotes>
    <PackageTags>osu game framework</PackageTags>
  </PropertyGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="FFmpeg.AutoGen" Version="4.3.0.1" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.5" />
    <PackageReference Include="ppy.managed-midi" Version="1.10.2" />
  </ItemGroup>

  <ItemGroup Label="ManagedBass Submodule">
    <!-- Use winnerspiros/ManagedBass fork (net10.0, typed AndroidAAudio/Mp3OldGaps/DevTimeout API, iOS static-linking support)
         instead of the stale ppy.ManagedBass 2022.1216.0 NuGet packages.
         PrivateAssets="all" suppresses emitting NuGet dependency entries that would reference a non-published fork version.
         The compiled assemblies are bundled directly into the package via IncludeManagedBassAssemblies below. -->
    <ProjectReference Include="..\submodules\managedbass\src\Bass\Portable\Bass.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\submodules\managedbass\src\AddOns\BassFx\BassFx.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\submodules\managedbass\src\AddOns\BassMix\BassMix.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\submodules\managedbass\src\AddOns\BassWasapi\BassWasapi.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Label="Veldrid Submodule">
    <!-- Use winnerspiros/veldrid fork (net10.0, C# 14, System.Threading.Lock, optimized, full D3D12) instead of the ppy NuGet package.
         PrivateAssets="all" prevents the ProjectReference from being recorded as a NuGet dependency in the produced nuspec
         (which would otherwise reference a non-existent ppy.Veldrid version produced by Nerdbank.GitVersioning, e.g. 4.9.111).
         The compiled assemblies are instead bundled directly into the package via the IncludeVeldridForkAssemblies target below. -->
    <ProjectReference Include="..\submodules\veldrid\src\Veldrid\Veldrid.csproj" PrivateAssets="all" />
    <!-- Build winnerspiros/veldrid-spirv (commit b268bf39ea) from source so the resulting Veldrid.SPIRV.dll is linked against
         our source-built ppy.Veldrid 4.9.111 (not the NuGet's 4.9.0.0, which would cause a runtime FileNotFoundException at
         first shader compile). The submodule's csproj ships a stale PackageReference to ppy.Veldrid 4.9.69-ga405fe8484 which is
         overridden in submodules/Directory.Build.targets to a sibling ProjectReference to the local Veldrid fork.
         PrivateAssets="all" + bundling pattern matches Veldrid above. -->
    <ProjectReference Include="..\submodules\veldrid-spirv\src\Veldrid.SPIRV\Veldrid.SPIRV.csproj" PrivateAssets="all" />
    <!-- Re-declare the Veldrid fork's runtime PackageReferences here so they are recorded in the produced nuspec
         and restored by consumers. PrivateAssets="all" on the ProjectReference above suppresses these transitively. -->
    <PackageReference Include="Vortice.Vulkan" Version="3.2.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <!-- Pull only the pre-built native libveldrid-spirv.* / libveldrid-spirvcross.* binaries from the
         ppy.Veldrid.SPIRV NuGet (the managed Veldrid.SPIRV.dll comes from the ProjectReference above so it
         is linked against our source-built ppy.Veldrid 4.9.111, not the NuGet's 4.9.0.0 — without
         IncludeAssets="native" the package's managed dll wins ResolveAssemblyReferences over the
         ProjectReference and triggers a runtime FileNotFoundException for ppy.Veldrid 4.9.0.0).
         No PrivateAssets here — natives must flow transitively to downstream test/game projects.
         The PackageId of the SPIRV submodule is renamed in submodules/Directory.Build.targets so this
         package isn't shadowed during NuGet restore.
         Local package in nuget-local/ (built from winnerspiros/veldrid-spirv submodule at gb268bf39e)
         takes precedence via nuget.config. Android native libs rebuilt with -Wl,-z,max-page-size=16384
         for Android 16 / 16KB page size compatibility (fixes XA0141). Update by running
         .github/workflows/build-veldrid-spirv.yml dispatch job. -->
    <PackageReference Include="ppy.Veldrid.SPIRV" Version="1.0.15-gb268bf39e" IncludeAssets="native" />
    <PackageReference Include="SharpFNT" Version="2.0.0" />
    <!-- Preview version of ImageSharp causes NU5104. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenTabletDriver" Version="0.6.7" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="StbiSharp" Version="1.2.1" />
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" />
    <!-- Updated to SDL 3.5.0-main (linux-x64 rebuilt from commit f6a1eb9ba96e; bindings extended with new text input props).
         Local package in nuget-local/ takes precedence via nuget.config. -->
    <PackageReference Include="ppy.SDL3-CS" Version="2026.512.0" />
    <PackageReference Include="ppy.osu.Framework.SourceGeneration" Version="2025.1121.1" />

    <!-- DO NOT use ProjectReference for native packaging project.
         See https://github.com/NuGet/Home/issues/4514 and https://github.com/dotnet/sdk/issues/765 . -->
    <PackageReference Include="ppy.osu.Framework.NativeLibs" Version="2025.806.0-nativelibs" />

    <!-- Any version ahead of this will cause AOT issues with iOS
         See https://github.com/mono/mono/issues/21188 -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="2.0.161401" />

    <!-- Any version ahead of this will cause runtime issues on iOS
         See https://github.com/xoofx/markdig/issues/564 -->
    <PackageReference Include="Markdig" Version="0.23.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.5" />
  </ItemGroup>

  <!-- Bundle the winnerspiros/veldrid fork DLLs (ppy.Veldrid + Veldrid.MetalBindings + Veldrid.OpenGLBindings) and
       winnerspiros/ManagedBass fork DLLs (ManagedBass + ManagedBass.Fx + ManagedBass.Mix + ManagedBass.Wasapi)
       directly into lib/<tfm>/ of the produced ppy.osu.Framework nupkg. This is required because both forks use
       PrivateAssets="all" to suppress NuGet dependency entries that would reference non-published fork versions. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeSubmoduleAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeSubmoduleAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'
                                       AND '%(ReferenceCopyLocalPaths.Extension)' == '.dll'
                                       AND ($([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('ppy.Veldrid'))
                                            OR $([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('Veldrid.'))
                                            OR $([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('ManagedBass')))" />
    </ItemGroup>
  </Target>
</Project>
