# EditorConfig override for third-party fork code under submodules/.
# Prevents osu-framework's strict style rules (which prefer block-scoped namespaces, etc.)
# from being applied as build-time errors to winnerspiros/veldrid and winnerspiros/veldrid-spirv source files.
# The forks have their own coding style; we don't enforce ours on them.
root = true

[*.cs]
# Allow file-scoped namespaces (used by winnerspiros/veldrid-spirv) without IDE0160 errors.
csharp_style_namespace_declarations = file_scoped:silent
dotnet_diagnostic.IDE0160.severity = none
dotnet_diagnostic.IDE0161.severity = none
