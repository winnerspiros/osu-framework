<Project>
  <!-- Disable code style enforcement and treat-warnings-as-errors for submodule projects.
       These projects have their own code style rules and should not be subject to osu-framework's strict CI rules.
       NoWarn is used because -warnaserror from CLI overrides TreatWarningsAsErrors in project files. -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Contains('submodules'))">
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);IDE0008;IDE0023;IDE0024;IDE0025;IDE0027;IDE0031;IDE0032;IDE0034;IDE0040;IDE0055;IDE0057</NoWarn>
  </PropertyGroup>
</Project>
