<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.4</SupportedOSPlatformVersion>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>osu!framework iOS</AssemblyTitle>
    <AssemblyName>osu.Framework.iOS</AssemblyName>
    <RootNamespace>osu.Framework.iOS</RootNamespace>
    <Description>A 2D application/game framework written with rhythm games in mind.</Description>
  </PropertyGroup>
  <PropertyGroup Label="Nuget">
    <Title>osu!framework iOS</Title>
    <PackageId>ppy.osu.Framework.iOS</PackageId>
    <PackageTags>osu game framework</PackageTags>
    <!-- NU5100: Stub assemblies in 'stubs/' are intentionally outside 'lib/' —
         they are only used during AOT compilation via the .targets file, not as package references. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\osu.Framework\osu.Framework.csproj" />
    <!-- Direct references needed because osu.Framework uses PrivateAssets="all" on its ManagedBass
         ProjectReferences, which prevents the assemblies from flowing transitively to this project.
         PrivateAssets="all" suppresses emitting NuGet dependency entries that would reference
         non-published fork versions; the compiled assemblies are bundled directly into the package
         via IncludeSubmoduleAssemblies below. -->
    <ProjectReference Include="..\submodules\managedbass\src\Bass\Portable\Bass.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\submodules\managedbass\src\AddOns\BassFx\BassFx.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\submodules\managedbass\src\AddOns\BassMix\BassMix.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Bundle winnerspiros/ManagedBass fork DLLs directly into lib/<tfm>/ of the produced nupkg.
       Required because the ProjectReferences above use PrivateAssets="all". -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeSubmoduleAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeSubmoduleAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'
                                       AND '%(ReferenceCopyLocalPaths.Extension)' == '.dll'
                                       AND $([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('ManagedBass'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes" />
    <None Include="stubs\**\*" Pack="true" PackagePath="stubs" />
    <None Include="osu.Framework.iOS.Workarounds.targets" Pack="true" PackagePath="build\$(PackageId).targets" />
  </ItemGroup>
</Project>
