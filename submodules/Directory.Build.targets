<Project>

  <!--
    Build customizations for projects under submodules/ (winnerspiros/veldrid + winnerspiros/veldrid-spirv).

    1. Replace the stale `ppy.Veldrid` PackageReference in winnerspiros/veldrid-spirv's Veldrid.SPIRV.csproj
       (pinned to 4.9.69-ga405fe8484, which lacks Direct3D12 and would also produce a Veldrid.SPIRV.dll
       linked against an assembly version that doesn't match our source-built ppy.Veldrid 4.9.111 — causing
       a runtime FileNotFoundException) with a sibling ProjectReference to the winnerspiros/veldrid submodule.

    2. Rename the Veldrid.SPIRV submodule's PackageId so it does not shadow the same-name `ppy.Veldrid.SPIRV`
       NuGet package (otherwise NuGet treats the ProjectReference as a substitute and skips restoring the
       package's runtimes/<RID>/native/libveldrid-spirv.* binaries entirely).

    3. Strip osu-framework's global analyzer config + BannedSymbols additional file from third-party fork
       projects. The root Directory.Build.props auto-injects:
         <GlobalAnalyzerConfigFiles Include="...\CodeAnalysis\osu-framework.globalconfig" />
         <AdditionalFiles Include="...\CodeAnalysis\BannedSymbols.txt" />
       and the Code Quality CI job runs `dotnet build -warnaserror -p:EnforceCodeStyleInBuild=true`. The
       globalconfig promotes IDExxxx style rules to `warning`, which `-warnaserror` then converts to errors
       inside the third-party fork sources we don't own. Remove these items for submodule projects so the
       forks build cleanly under their own (upstream) style configuration.
  -->

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Veldrid.SPIRV'">
    <PackageId>ppy.Veldrid.SPIRV.Source</PackageId>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Veldrid.SPIRV'">
    <PackageReference Remove="ppy.Veldrid" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)veldrid\src\Veldrid\Veldrid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Remove="@(GlobalAnalyzerConfigFiles)" />
    <AdditionalFiles Remove="@(AdditionalFiles)" Condition="$([System.String]::Copy('%(AdditionalFiles.Filename)').Equals('BannedSymbols'))" />
  </ItemGroup>

  <!--
    Belt-and-braces NoWarn for warnings that the CI jobs currently surface inside the
    third-party fork sources:

      * CS1591 (missing XML doc comment) — fires during `dotnet pack` because the root
        osu-framework Directory.Build.props sets GenerateDocumentationFile=true. That
        props file's own `<NoWarn>$(NoWarn);CS1591</NoWarn>` does NOT flow into submodule
        projects because the veldrid submodule ships its own Directory.Build.props, which
        stops MSBuild's upward walk for `.props` files (but not for `.targets`, hence this
        file still applies).

      * IDE0xxx style rules — the Code Quality CI job runs
        `dotnet build -warnaserror -p:EnforceCodeStyleInBuild=true`. Removing
        GlobalAnalyzerConfigFiles above strips osu-framework's severity assignments, but
        `EnforceCodeStyleInBuild=true` (a command-line global MSBuild property that cannot
        be reset from a project file) still enables every IDE analyzer with its Roslyn
        default severity, and `-warnaserror` then converts those warnings to errors.

    NoWarn reliably suppresses both the warning and its `-warnaserror` upgrade.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591;IDE0008;IDE0023;IDE0024;IDE0025;IDE0027;IDE0031;IDE0032;IDE0034;IDE0040;IDE0057;IDE0160;IDE0161</NoWarn>
  </PropertyGroup>

</Project>
